{
  "name": "cubesmp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @cubesmp/web dev",
    "build": "pnpm --filter @cubesmp/web build",
    "lint": "pnpm --filter @cubesmp/web lint",
    "typecheck": "pnpm --filter @cubesmp/web typecheck",
    "db:generate": "pnpm --filter @cubesmp/web db:generate",
    "db:migrate": "pnpm --filter @cubesmp/web db:migrate"
  },
  "devDependencies": { "typescript": "^5.7.3" }
}