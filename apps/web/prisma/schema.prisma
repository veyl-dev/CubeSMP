generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MODERATOR
  PLAYER
}

enum PaymentMethod {
  GCASH
  MAYA
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

enum DeliveryStatus {
  QUEUED
  CLAIMED
  SUCCEEDED
  FAILED
}

enum ProductType {
  RANK
  POINTS
  ITEM
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  minecraftName   String   @unique
  passwordHash    String
  role            UserRole @default(PLAYER)
  suspended       Boolean  @default(false)
  pointsBalance   Int      @default(0)
  currentRank     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sessions        Session[]
  orders          Order[]
  pointEntries    PointLedger[]
  approvedPayments PaymentTransaction[] @relation("PaymentReviewer")
  auditEvents     AuditLog[] @relation("AuditActor")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String      @default("")
  imageUrl       String?
  priceMinor     Int
  currency       String      @default("PHP")
  type           ProductType @default(ITEM)
  enabled        Boolean     @default(true)
  featured       Boolean     @default(false)
  pointsAmount   Int?
  rankKey        String?
  benefits       Json?
  deliveryCommands Json?
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  @@index([enabled, type])
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  status      TransactionStatus @default(PENDING)
  totalMinor  Int
  currency    String   @default("PHP")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payment     PaymentTransaction?
  delivery    DeliveryJob?
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int     @default(1)
  unitPriceMinor Int
  productName String
  product     Product @relation(fields: [productId], references: [id])
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model PaymentTransaction {
  id                String @id @default(cuid())
  orderId           String @unique
  method            PaymentMethod
  referenceNumber   String
  amountMinor       Int
  proofObjectKey    String
  status            TransactionStatus @default(PENDING)
  rejectionReason   String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  order             Order @relation(fields: [orderId], references: [id])
  reviewer          User? @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  @@index([status, createdAt])
  @@index([referenceNumber])
}

model PointLedger {
  id          String   @id @default(cuid())
  userId      String
  delta       Int
  reason      String
  referenceId String?  @unique
  actorId     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
}

model DeliveryJob {
  id           String @id @default(cuid())
  orderId      String @unique
  status       DeliveryStatus @default(QUEUED)
  attempts     Int @default(0)
  claimedAt    DateTime?
  claimedBy    String?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        Order @relation(fields: [orderId], references: [id])
  logs         DeliveryLog[]
  @@index([status, createdAt])
}

model DeliveryLog {
  id          String @id @default(cuid())
  jobId       String
  event       String
  detail      String?
  createdAt   DateTime @default(now())
  job         DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, createdAt])
}

model WebsiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

model PaymentMethodSetting {
  method       PaymentMethod @id
  accountName  String
  accountNumber String
  qrObjectKey  String?
  instructions String
  enabled      Boolean @default(false)
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User? @relation("AuditActor", fields: [actorId], references: [id])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
