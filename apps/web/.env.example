# CubeSMP web application
NODE_ENV=development
APP_URL=http://localhost:3000
SUPABASE_URL=https://iqynxfgcqokwhhgcbkcm.supabase.co
# Server-only Supabase secret key. Never use NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=replace_with_server_secret_key

# Supabase PostgreSQL (runtime pooler + direct migration connection)
DATABASE_URL=postgresql://postgres.iqynxfgcqokwhhgcbkcm:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.iqynxfgcqokwhhgcbkcm.supabase.co:5432/postgres

SESSION_SECRET=replace_with_at_least_32_random_characters
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_MINECRAFT_NAME=

# Public server status (Java status ping)
MINECRAFT_SERVER_HOST=play.example.com
MINECRAFT_SERVER_PORT=25565

# Minecraft Bridge API
BRIDGE_SHARED_SECRET=replace_with_at_least_32_random_characters
BRIDGE_POLL_LIMIT=10
BRIDGE_MAX_ATTEMPTS=3

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
