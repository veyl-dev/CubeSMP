# Supabase CubeSMP project
SUPABASE_URL=https://iqynxfgcqokwhhgcbkcm.supabase.co
# Server-only key from Supabase Dashboard > Project Settings > API Keys.
# Never expose this key to browser code or use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=replace_with_server_secret_key

# Prisma PostgreSQL connection strings. Use the Supabase pooler for runtime and direct URL for migrations.
DATABASE_URL=postgresql://postgres.iqynxfgcqokwhhgcbkcm:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.iqynxfgcqokwhhgcbkcm.supabase.co:5432/postgres

APP_URL=http://localhost:3000
SESSION_SECRET=replace_with_long_random_secret
BRIDGE_API_KEY=replace_with_long_random_bridge_secret
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
