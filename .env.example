# Web application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cubesmp?schema=public
SESSION_SECRET=replace-with-at-least-32-random-bytes
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_MINECRAFT_NAME=

# Private payment-proof storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=cubesmp-payment-proofs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Minecraft Bridge API
BRIDGE_SHARED_SECRET=replace-with-a-long-random-secret
BRIDGE_POLL_LIMIT=10
BRIDGE_MAX_ATTEMPTS=3

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
